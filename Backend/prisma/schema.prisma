datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MERCHANT
  ADMIN
  STAFF
}

enum SubscriptionTier {
  STARTER
  STARTER_PLUS
  PRO
  BUSINESS
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum PromoDiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  phoneNumber          String    @unique
  passwordHash         String
  fullName             String
  role                 Role      @default(MERCHANT)
  emailVerified        Boolean   @default(true)
  emailVerifyCodeHash  String?
  emailVerifyExpires   DateTime?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  stores        Store[]

  @@map("users")
}

model Store {
  id               String           @id @default(cuid())
  ownerId          String
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  slug             String           @unique // e.g. "becaria"
  description      String?
  aboutText        String?          @db.Text
  logoUrl          String?
  bannerUrl        String?
  themeColor       String           @default("#0f172a")
  whatsappNumber   String
  contactPhone     String?
  contactEmail     String?
  address          String?
  socialLinks      Json?            // e.g. { instagram, tiktok, facebook, twitter }
  currency         String           @default("NGN")
  
  subscriptionTier  SubscriptionTier @default(STARTER)
  subscriptionEnd   DateTime?
  isActive            Boolean          @default(true)
  allowSearchIndexing Boolean          @default(true)
  payFromWallet       Boolean          @default(true)
  passFeeToCustomer Boolean          @default(false)
  shippingConfig    Json?            // { defaultFee, freeDeliveryEnabled, freeDeliveryScope, freeDeliveryStates, freeDeliveryMinOrder, stateRates }
  kycStatus         String           @default("UNVERIFIED") // UNVERIFIED | PENDING | VERIFIED | REJECTED
  kycIdType         String?
  kycIdLast4        String?
  kycVerifiedName   String?
  kycVerifiedAt     DateTime?

  bankCode               String?
  bankName               String?
  accountNumber          String?
  accountName            String?
  withdrawalLockedUntil  DateTime?
  bankChangeOtpHash      String?
  bankChangeOtpExpires   DateTime?
  withdrawalOtpHash      String?
  withdrawalOtpExpires   DateTime?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  products              Product[]
  orders                Order[]
  wallet                Wallet?
  customers             Customer[]
  promoCodes            PromoCode[]
  pushSubscriptions     PushSubscription[]
  subscriptionPayments  SubscriptionPayment[]
  lastRenewalReminderAt DateTime?

  @@map("stores")
}

model SubscriptionPlan {
  id                 String           @id @default(cuid())
  tier               SubscriptionTier @unique
  name               String
  tagline            String?
  monthlyPrice       Decimal          @db.Decimal(12, 2) @default(0)
  annualPrice        Decimal          @db.Decimal(12, 2) @default(0)
  maxProducts         Int              @default(20)
  maxImagesPerProduct Int              @default(2)
  platformFeePercent  Decimal          @db.Decimal(5, 2) @default(2.5)
  allowPassFee       Boolean          @default(false)
  allowPromoCodes    Boolean          @default(false)
  allowOfferBanner   Boolean          @default(false)
  allowCustomDomain  Boolean          @default(false)
  isActive           Boolean          @default(true)
  updatedAt          DateTime         @updatedAt

  @@map("subscription_plans")
}

model SubscriptionPayment {
  id            String           @id @default(cuid())
  storeId       String
  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tier          SubscriptionTier
  billingCycle  String           @default("MONTHLY")
  amount        Decimal          @db.Decimal(12, 2)
  paymentMethod String
  reference     String           @unique
  status        String           @default("COMPLETED")
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime         @default(now())

  @@index([storeId])
  @@index([tier, status])
  @@map("subscription_payments")
}

model Product {
  id            String           @id @default(cuid())
  storeId       String
  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title         String
  slug          String
  description   String?
  category      String?          // Merchant-defined custom category (e.g. "iPhones", "Bone Straight", "Sneakers")
  brand         String?          // Optional legacy brand name
  attributes    Json?            // Dynamic key-value details e.g. [{ label: "Material", value: "Cotton" }]
  basePrice     Decimal          @db.Decimal(12, 2)
  comparePrice  Decimal?         @db.Decimal(12, 2)
  images        String[]         // Max 2 URLs (WebP on VPS storage)
  isActive      Boolean          @default(true)
  isFeatured    Boolean          @default(false)
  stockQuantity Int              @default(0)
  hasVariants   Boolean          @default(false)
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  variants      ProductVariant[]
  orderItems    OrderItem[]

  @@unique([storeId, slug])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String      // e.g. "Size: 42, Color: Black"
  price         Decimal     @db.Decimal(12, 2)
  stockQuantity Int         @default(0)
  sku           String?
  
  orderItems    OrderItem[]

  @@map("product_variants")
}

model Customer {
  id                  String    @id @default(cuid())
  storeId             String
  store               Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fullName            String
  phoneNumber         String
  email               String?
  passwordHash        String?
  isRegistered        Boolean   @default(false)
  emailVerified       Boolean   @default(false)
  emailVerifyCodeHash String?
  emailVerifyExpires  DateTime?
  resetCodeHash       String?
  resetCodeExpires    DateTime?
  profileOtpHash      String?
  profileOtpExpires   DateTime?
  address             String?
  city                String?
  state               String?
  createdAt           DateTime  @default(now())

  orders              Order[]

  @@unique([storeId, phoneNumber])
  @@unique([storeId, email])
  @@map("customers")
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique // e.g. "KRD-10492"
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  
  subtotal       Decimal       @db.Decimal(12, 2)
  shippingFee    Decimal       @db.Decimal(12, 2) @default(0)
  discountAmount Decimal       @db.Decimal(12, 2) @default(0)
  promoCode      String?
  totalAmount    Decimal       @db.Decimal(12, 2)
  
  orderStatus   OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentRef    String?       @unique

  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         OrderItem[]
  transaction   Transaction?

  @@map("orders")
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  
  productTitle String
  variantName  String?
  unitPrice    Decimal         @db.Decimal(12, 2)
  quantity     Int
  subtotal     Decimal         @db.Decimal(12, 2)

  @@map("order_items")
}

model Wallet {
  id               String        @id @default(cuid())
  storeId          String        @unique
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  availableBalance Decimal       @db.Decimal(12, 2) @default(0)
  escrowBalance    Decimal       @db.Decimal(12, 2) @default(0)
  updatedAt        DateTime      @updatedAt

  transactions     Transaction[]

  @@map("wallets")
}

model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  orderId     String?  @unique
  order       Order?   @relation(fields: [orderId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  platformFee Decimal  @db.Decimal(12, 2) @default(0)
  netAmount   Decimal  @db.Decimal(12, 2)
  type        String   // "SALE", "WITHDRAWAL", "SUBSCRIPTION_DEDUCTION"
  status      String   // "PENDING", "COMPLETED", "FAILED"
  reference   String   @unique
  createdAt   DateTime @default(now())

  @@map("transactions")
}

model PromoCode {
  id             String            @id @default(cuid())
  storeId        String
  store          Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code           String
  discountType   PromoDiscountType @default(PERCENTAGE)
  discountValue  Decimal           @db.Decimal(12, 2)
  minOrderAmount Decimal?          @db.Decimal(12, 2)
  maxUses        Int?
  usedCount      Int               @default(0)
  expiresAt      DateTime?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([storeId, code])
  @@map("promo_codes")
}

model PushSubscription {
  id        String   @id @default(cuid())
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  isAdmin   Boolean  @default(false)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([isAdmin])
  @@map("push_subscriptions")
}
