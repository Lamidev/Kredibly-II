datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  MERCHANT
  ADMIN
  STAFF
}

enum SubscriptionTier {
  STARTER
  PRO
  BUSINESS
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  phoneNumber          String    @unique
  passwordHash         String
  fullName             String
  role                 Role      @default(MERCHANT)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  stores        Store[]

  @@map("users")
}

model Store {
  id               String           @id @default(cuid())
  ownerId          String
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name             String
  slug             String           @unique // e.g. "becaria"
  description      String?
  logoUrl          String?
  bannerUrl        String?
  themeColor       String           @default("#0f172a")
  whatsappNumber   String
  currency         String           @default("NGN")
  
  subscriptionTier  SubscriptionTier @default(STARTER)
  subscriptionEnd   DateTime?
  payFromWallet     Boolean          @default(true)
  passFeeToCustomer Boolean          @default(true)

  bankCode         String?
  bankName         String?
  accountNumber    String?
  accountName      String?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  products         Product[]
  orders           Order[]
  wallet           Wallet?
  customers        Customer[]

  @@map("stores")
}

model Product {
  id            String           @id @default(cuid())
  storeId       String
  store         Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title         String
  slug          String
  description   String?
  category      String?          // Merchant-defined custom category (e.g. "iPhones", "Bone Straight", "Sneakers")
  brand         String?          // Optional brand name (e.g. "Apple", "Nike")
  basePrice     Decimal          @db.Decimal(12, 2)
  comparePrice  Decimal?         @db.Decimal(12, 2)
  images        String[]         // Max 2 URLs (WebP on VPS storage)
  isActive      Boolean          @default(true)
  isFeatured    Boolean          @default(false)
  stockQuantity Int              @default(0)
  hasVariants   Boolean          @default(false)
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  variants      ProductVariant[]
  orderItems    OrderItem[]

  @@unique([storeId, slug])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String      // e.g. "Size: 42, Color: Black"
  price         Decimal     @db.Decimal(12, 2)
  stockQuantity Int         @default(0)
  sku           String?
  
  orderItems    OrderItem[]

  @@map("product_variants")
}

model Customer {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fullName    String
  phoneNumber String
  email       String?
  address     String?
  city        String?
  state       String?
  createdAt   DateTime  @default(now())

  orders      Order[]

  @@unique([storeId, phoneNumber])
  @@map("customers")
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique // e.g. "KRD-10492"
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  
  subtotal      Decimal       @db.Decimal(12, 2)
  shippingFee   Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount   Decimal       @db.Decimal(12, 2)
  
  orderStatus   OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentRef    String?       @unique

  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         OrderItem[]
  transaction   Transaction?

  @@map("orders")
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  
  productTitle String
  variantName  String?
  unitPrice    Decimal         @db.Decimal(12, 2)
  quantity     Int
  subtotal     Decimal         @db.Decimal(12, 2)

  @@map("order_items")
}

model Wallet {
  id               String        @id @default(cuid())
  storeId          String        @unique
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  availableBalance Decimal       @db.Decimal(12, 2) @default(0)
  escrowBalance    Decimal       @db.Decimal(12, 2) @default(0)
  updatedAt        DateTime      @updatedAt

  transactions     Transaction[]

  @@map("wallets")
}

model Transaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  orderId     String?  @unique
  order       Order?   @relation(fields: [orderId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  platformFee Decimal  @db.Decimal(12, 2) @default(0)
  netAmount   Decimal  @db.Decimal(12, 2)
  type        String   // "SALE", "WITHDRAWAL", "SUBSCRIPTION_DEDUCTION"
  status      String   // "PENDING", "COMPLETED", "FAILED"
  reference   String   @unique
  createdAt   DateTime @default(now())

  @@map("transactions")
}
